            <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
              <pou name="FB_Hopper" pouType="functionBlock">
                <interface>
                  <inputVars>
                    <variable name="StartDispense">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="StopDispense">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                  </inputVars>
                  <outputVars>
                    <variable name="Status">
                      <type>
                        <derived name="HopperStatus" />
                      </type>
                    </variable>
                  </outputVars>
                  <localVars>
                    <variable name="Internal_State">
                      <type>
                        <BOOL />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> False=Idle True= Dispensing</xhtml>
                      </documentation>
                    </variable>
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">//Hopper Control Logic
IF StartDispense THEN
	Status.Is_Dispensing:= TRUE;
	Internal_State := TRUE;
ELSIF StopDispense THEN
	Status.Is_Dispensing:= FALSE;
	Internal_State := FALSE;
END_IF

//Simulate Ingredient level
IF Internal_State =1 THEN
   Status.Fill_Level := Status.Fill_Level - 0.1; // Decrement per Order
END_IF

//Alarm Logic
status.Alarm_Active := (status.Fill_Level &lt; 5.0);</xhtml>
                  </ST>
                </body>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                    <ObjectId>8d5ee0aa-921f-4261-b7df-9ec89e21f0a7</ObjectId>
                  </data>
                </addData>
              </pou>
            </data>
            <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
              <pou name="FB_Conveyor" pouType="functionBlock">
                <interface>
                  <inputVars>
                    <variable name="Start">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="Speed_Setpoint">
                      <type>
                        <REAL />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml">percentage in speed</xhtml>
                      </documentation>
                    </variable>
                  </inputVars>
                  <outputVars>
                    <variable name="Running">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="Fault">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="Jam_Detected">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="Current_Speed">
                      <type>
                        <REAL />
                      </type>
                    </variable>
                  </outputVars>
                  <localVars>
                    <variable name="State">
                      <type>
                        <INT />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml">0=Ideal, 1=running, 2=Fault</xhtml>
                      </documentation>
                    </variable>
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">// Logic Framework
IF Fault THEN
	Running := FALSE;
	Current_Speed := 0.0;
	State := 2;
ELSE
	IF NOT Fault AND Start = TRUE THEN
	   Running := TRUE;
	   Current_Speed := Speed_Setpoint;
	   State := 1;
	 ELSIF NOT Start THEN 
     	Running := FALSE;
	    Current_Speed := 0.0;
	    State := 0;	
		 
		
		
	END_IF
	
END_IF


	
</xhtml>
                  </ST>
                </body>
                <addData>
