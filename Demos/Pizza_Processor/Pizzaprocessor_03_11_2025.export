          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//Hopper Control Logic
IF StartDispense THEN
	Status.Is_Dispensing:= TRUE;
	Internal_State := TRUE;
ELSIF StopDispense THEN
	Status.Is_Dispensing:= FALSE;
	Internal_State := FALSE;
END_IF

//Simulate Ingredient level
IF Internal_State =1 THEN
   Status.Fill_Level := Status.Fill_Level - 0.1; // Decrement per Order
END_IF

//Alarm Logic
status.Alarm_Active := (status.Fill_Level &lt; 5.0);</Single>
