      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Logic Framework
IF Fault THEN
	Running := FALSE;
	Current_Speed := 0.0;
	State := 2;
ELSE
	IF NOT Fault AND Start = TRUE THEN
	   Running := TRUE;
	   Current_Speed := Speed_Setpoint;
	   State := 1;
	 ELSIF NOT Start THEN 
     	Running := FALSE;
	    Current_Speed := 0.0;
	    State := 0;	
		 
		
		
	END_IF
	
END_IF


	
</Single>
            <Single Name="LineInfoPersistence" Type="string">45990637-b69c-49e8-9b2e-c0c93758eb6a_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_Conveyor
VAR_INPUT
	Start: BOOL;
	Speed_Setpoint: REAL; //percentage in speed
END_VAR
VAR_OUTPUT
	Running: BOOL; //
	Fault: BOOL; //
	Jam_Detected: BOOL; //
	Current_Speed: REAL; //
END_VAR

VAR
	State: INT; //0=Ideal, 1=running, 2=Fault
END_VAR
</Single>
