          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM Supervisor_PRG
VAR
	//Mode Control
	b_Mode: BOOL; //True = Auto, False = Manual

	//Status from Sensor
	b_Hopper_Empty:ARRAY[1..5] OF BOOL; // 1=Base, 2=Toppings, 3=Oregano, 4=Chilli, 5=Box (if you treat Box similarly)
	b_Conveyor_Jam: ARRAY [1..3] OF BOOL; //3 conveyors Jam Status

	//Process Flags
	 // Interlocks for hoppers or zones (e.g., 1=Base Hopper, 2=Toppings Hopper, etc.)
    b_Interlock_Hopper: ARRAY[1..5] OF BOOL;  // Matches hopper indices
    // Interlocks for conveyors
    b_Interlock_Conveyor: ARRAY[1..3] OF BOOL;
    // Interlocks for other zones like Heating, Packing - separate BOOLs or an array
    b_Interlock_OtherZones: ARRAY[1..2] OF BOOL; // Example: 1=HeatingZone, 2=PackingStation


	 // Alarm Flags
    b_Alarm_HopperEmpty : BOOL;
    b_Alarm_ConveyorJam : BOOL;
	
	

    // Identifier
    i_Jammed_Conveyor_Index : INT;    // 0 = none, else 1..n conveyor index
    i_Empty_Hopper_Index: INT;
    // Alarm Reset Command
    b_Alarm_Reset_Command : BOOL;      // Command from HMI to reset alarms
	
		
END_VAR</Single>
