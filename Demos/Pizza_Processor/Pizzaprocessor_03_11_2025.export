            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_Hopper
VAR_INPUT
	StartDispense: BOOL;
	StopDispense:BOOL;
END_VAR
VAR_OUTPUT
	Status:HopperStatus;
END_VAR
VAR Internal_State: BOOL; // False=Idle True= Dispensing
END_VAR
</Single>
